# ==============================================================================
# SlotSync Backend Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the `server` directory and customize for your environment.

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="SlotSync API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="sqlite+aiosqlite:///./slotsync.db"

# Production VPS (PostgreSQL / MySQL example):
# DATABASE_URL="postgresql+asyncpg://slotsync_user:your_secure_password@localhost:5432/slotsync_db"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a secure random key for production: `openssl rand -hex 32`
SECRET_KEY="slotsync_super_secret_jwt_key_change_in_production_12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days (60 * 24 * 7)

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP CONFIGURATION (For 6-Digit OTP Verification)
# ------------------------------------------------------------------------------
# If SMTP_HOST is left empty, OTP codes will be printed directly to the server terminal console.
# To send real emails via your VPS postfix / SMTP provider (e.g., Gmail, SendGrid, Amazon SES):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL="noreply@slotsync.app"
EMAILS_FROM_NAME="SlotSync Verification"

# Example for Gmail SMTP:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password" # Use App Password from Google Account Security
# SMTP_TLS=True

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# (Web client ID or Android client ID)
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 6. FIREBASE CLOUD MESSAGING (Optional - for Push Notifications)
# ------------------------------------------------------------------------------
# Path to your Firebase service account JSON key file
FIREBASE_CREDENTIALS_FILE=
