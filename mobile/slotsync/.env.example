# ==============================================================================
# SlotSync Mobile Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the `mobile/slotsync` directory and customize for your environment.

# ------------------------------------------------------------------------------
# API BASE URL
# ------------------------------------------------------------------------------
# Production VPS backend endpoint:
EXPO_PUBLIC_API_BASE_URL=https://coinmarketscap.online/api/v1

# Local development backend endpoint (using your local machine IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.142:8000/api/v1

# Android Emulator localhost:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1
